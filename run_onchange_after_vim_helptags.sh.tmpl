{{- if ne .chezmoi.os "windows" -}}
#!/bin/sh
# .chezmoiexternal.toml hash: {{ include ".chezmoiexternal.toml" | sha256sum }}
command -v vim >/dev/null 2>&1 || exit 0
for d in "$HOME"/.vim/pack/*/*/*/doc; do
  [ -d "$d" ] && vim -u NONE -i NONE -es -c "silent! helptags $d" -c q
done
exit 0
{{ end -}}
